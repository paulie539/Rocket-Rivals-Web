---
import Layout from '../layouts/Layout.astro';
import AwardCard from '../components/AwardCard.astro';

import '../styles/about.css';

// Placeholder data for testing the award-card design — swap for real
// Hall of Fame results once they're finalized.
const AWARDS = [
  { award: 'MVP', playerName: 'Kestrel', team: 'Nightfall Ravens', season: 'Season 8', division: 'challengers' },
  { award: 'Golden Boot', playerName: 'Vantage', team: 'Ironclad Foxes', season: 'Season 8', division: 'challengers' },
  { award: 'Rookie of the Season', playerName: 'Pixie', team: 'Skyline Wolves', season: 'Season 8', division: 'challengers' },
  { award: 'MVP', playerName: 'Halcyon', team: 'Solar Flare', season: 'Season 8', division: 'legends' },
  { award: 'Best Goalkeeper', playerName: 'Junoo', team: 'Ember Sentinels', season: 'Season 8', division: 'legends' },
  { award: 'Most Improved', playerName: 'Draven', team: 'Crimson Tide', season: 'Season 8', division: 'legends' },
  { award: 'MVP', playerName: 'Wraith', team: 'Obsidian Fangs', season: 'Season 8', division: 'titans' },
  { award: 'Clutch Player of the Season', playerName: 'Lumen', team: 'Nova Wolves', season: 'Season 8', division: 'titans' },
  { award: 'Sportsperson of the Year', playerName: 'Ashen', team: 'Twilight Hounds', season: 'Season 8', division: 'titans' },
] as const;

// Grouped into clusters of 3 (one per division) for the triangle layout.
const AWARD_CLUSTERS = [AWARDS.slice(0, 3), AWARDS.slice(3, 6), AWARDS.slice(6, 9)];

// Secondary tier — same per-division triangle shape, smaller cards.
const MINOR_AWARDS = [
  { award: 'Best Rotator', playerName: 'Nyx', team: 'Nightfall Ravens', season: 'Season 8', division: 'challengers' },
  { award: 'Highlight of the Season', playerName: 'Solstice', team: 'Ironclad Foxes', season: 'Season 8', division: 'challengers' },
  { award: 'Community Choice', playerName: 'Wisp', team: 'Skyline Wolves', season: 'Season 8', division: 'challengers' },
  { award: 'Hardest Worker', playerName: 'Faelan', team: 'Solar Flare', season: 'Season 8', division: 'legends' },
  { award: 'Best Teammate', playerName: 'Sable', team: 'Ember Sentinels', season: 'Season 8', division: 'legends' },
  { award: 'Fan Favorite', playerName: 'Roux', team: 'Crimson Tide', season: 'Season 8', division: 'legends' },
  { award: 'Most Aerial Goals', playerName: 'Zephyr', team: 'Obsidian Fangs', season: 'Season 8', division: 'titans' },
  { award: 'Best Comeback', playerName: 'Indigo', team: 'Nova Wolves', season: 'Season 8', division: 'titans' },
  { award: 'Iron Wall', playerName: 'Marrow', team: 'Twilight Hounds', season: 'Season 8', division: 'titans' },
] as const;

const MINOR_AWARD_CLUSTERS = [MINOR_AWARDS.slice(0, 3), MINOR_AWARDS.slice(3, 6), MINOR_AWARDS.slice(6, 9)];
---

<Layout
  title="About"
  description="Learn about Rocket Rivals, a community-driven Rocket League league founded in 2023 with 600+ Discord members, fair competition, and a welcoming community."
>
  <div>
    <h2><strong>Thank you for your interest!</strong></h2>
    <p>Rocket Rivals is a friendly, community-driven league that was established in early 2023, and has grown to a size of 600+ discord members. It was founded by FallenRealms, and consists of a community of viewers, players, coaches, managers, graphic designers, casters/streamers, partners, administrators, and more. If you fit into one of these categories please don't hesitate to join! We welcome any and all members to our community, and are adamant about maintaining a <strong>fun, fair, and competitive</strong> space for everyone.</p>
    <p>For more information regarding rules, eligibility, and division placement, check out our <a href="https://docs.google.com/document/d/159WSPLjo71WpS_vPIxVrLttubZj-A65V5V-kzi4S14A/edit?tab=t.opzyxlhtj6sx">Official Rulebook </a>and <a href="https://docs.google.com/document/d/1o6ZK-9OpQhNDw9iNP4FHCemVkSpunbb73IS7Q4mvrVY/edit?tab=t.0">Guidebook&nbsp;</a></p>
  </div>

  <div class="rr-spacer--lg"></div>

  <!-- Branch art: laurel-single.svg. Native curve reads as the left branch.
       The right instance below just
       mirrors it via CSS (scaleX(-1)) rather than needing a second asset. -->
  <svg style="display: none" aria-hidden="true">
    <symbol id="hof-laurel-branch" viewBox="0 0 9687 15065">
      <path class="hall-of-fame__laurel-path" d="m5290 48c125 138-115 557-535 936-316 286-693 414-877 440-263 204-501 420-716 647l-23 27c154-85 549-208 989-154 561 68 998 273 976 458s-496 279-1057 211c-522-63-923-353-971-441l-258 298c-45 57-88 114-130 171l-117 166c-116 172-222 347-317 527 127-121 478-341 917-403 560-78 1035 8 1061 192s-408 397-968 475c-525 73-990-107-1053-179-215 423-372 866-477 1319 103-155 380-439 771-603 522-218 1003-256 1075-84s-293 487-815 705c-475 198-957 151-1057 99-82 394-125 795-132 1199 0 480 48 960 134 1429l79 288c8-178 106-576 375-922 346-447 747-717 894-603s-15 569-361 1016c-326 420-786 616-880 607l237 862c241 659 554 1285 953 1859-60-132-133-578 9-1039 167-540 447-934 624-879 178 55 186 538 19 1078s-567 897-624 879c-1 0-2-1-2-1 71 100 144 199 220 296l643 697c-73-193-145-521-100-877 70-561 277-997 462-974 184 23 277 497 206 1058-61 482-313 860-421 952l82 89 922 758c-109-174-247-490-269-859-34-564 89-1031 275-1042s363 438 397 1002c29 484-150 901-239 1013 358 233 732 422 1126 578-138-156-313-421-402-749-147-546-121-1028 58-1076 180-48 444 355 592 901 118 438 46 855-16 1012 70 25 141 49 213 73l985 230c-167-123-384-336-538-623-266-499-350-974-186-1062s513 246 779 745c219 409 239 843 210 1001l773 148c254 73 509 205 692 399l172 228c35 75 3 164-72 200-75 35-164 3-200-72-63-130-129-244-255-327-354-232-757-309-1163-380-51 149-284 519-681 768-479 301-947 417-1046 259-99-157 209-529 688-829 239-150 493-228 690-261-95-19-190-40-283-65-293-79-580-171-861-278-35 102-364 463-855 632-534 185-1017 192-1078 17-61-176 323-468 858-653 322-112 641-115 847-88-398-168-781-371-1142-614-63 96-455 376-963 443-561 73-1035-17-1059-202-24-184 411-393 972-466 351-46 674 21 869 93l-897-761c-33-32-67-65-100-97-48 75-501 298-1037 269-565-31-1014-207-1004-393s476-311 1041-280c372 21 691 158 865 267-312-321-605-666-861-1033-109 69-563 184-1049 70-551-129-963-380-920-561 42-181 523-223 1074-94 323 76 588 235 749 366-1-1-1-2-2-3l-579-1135c-53 54-567 117-1070-99-520-223-882-542-809-713s554-129 1074 94c390 167 663 454 765 610l-400-1106c-21-78-40-157-58-236-73 41-582 5-1031-296-470-314-767-695-664-849 103-155 568-25 1038 290 328 219 538 522 623 701-94-454-145-918-154-1382-1 5-3 9-5 11-43 42-562-91-958-494s-610-836-478-966c133-130 562 91 958 494 315 320 458 715 482 885-5-476 33-953 115-1420 130-743 447-1466 899-2070l43-49c152-226 322-460 469-626 148-167 307-307 438-421l8-9 268-259c-40-46 115-557 535-936s861-574 986-436zm-2164 2c186 9 313 475 284 1040s-328 1009-388 1006-313-475-284-1040 203-1015 388-1006zm-1409 1307c182-38 424 379 541 932s-59 1059-118 1071-424-379-541-932-64-1033 118-1071zm-1018 1626c166-83 507 259 760 764 254 505 212 1039 159 1066-54 27-507-259-760-764-254-505-325-983-159-1066zm2461 2047c121 141-130 554-560 921s-958 455-997 409 130-554 560-921 876-550 997-409zm68 2450c165 85 90 562-169 1065-258 503-714 784-767 757s-90-562 169-1065c258-503 602-842 767-757z" />
    </symbol>
  </svg>

  <div class="rr-spacer--lg"></div>

  <div class="hall-of-fame-section">
    <div class="hall-of-fame__laurel" aria-hidden="true">
      <svg class="hall-of-fame__laurel-branch hall-of-fame__laurel-branch--left" viewBox="0 0 9687 15065">
        <use href="#hof-laurel-branch"></use>
      </svg>
      <svg class="hall-of-fame__laurel-branch hall-of-fame__laurel-branch--right" viewBox="0 0 9687 15065">
        <use href="#hof-laurel-branch"></use>
      </svg>
    </div>

    <div class="hall-of-fame">
      <h2 class="hall-of-fame__title">Hall of Fame</h2>
      <p class="hall-of-fame__subtitle">Awards and Distinctions</p>
    </div>
  </div>

  <div class="rr-spacer--lg"></div>
  <div class="hall-of-fame-section">
    <h1 class="hall-of-fame__season"> Season 8 </h1>
  </div>


  <div class="hall-of-fame__awards">
    <div class="hall-of-fame__awards-grid">
      {AWARD_CLUSTERS.map((cluster) => (
        <div class="hall-of-fame__cluster">
          {cluster.map((entry) => <AwardCard {...entry} />)}
        </div>
      ))}
    </div>

    <p class="hall-of-fame__awards-label">Also Recognized</p>

    <div class="hall-of-fame__awards-grid">
      {MINOR_AWARD_CLUSTERS.map((cluster) => (
        <div class="hall-of-fame__cluster hall-of-fame__cluster--sm">
          {cluster.map((entry) => <AwardCard {...entry} size="sm" />)}
        </div>
      ))}
    </div>
  </div>

  <div class="rr-spacer--lg"></div>
  <div class="rr-spacer--lg"></div>
</Layout>
